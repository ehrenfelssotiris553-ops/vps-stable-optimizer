#!/usr/bin/expect -f
# Drives one interactive command of the tool on a pseudo terminal (CI only).
# Usage: answer.exp RULES LOG COMMAND [ARG ...]
#
# RULES holds lines "pattern ==> answer". The pattern is a regular expression
# for the question waiting at the end of the output; the first rule whose
# pattern matches answers it. Answers:
#   (nothing)      just Enter
#   !COMMAND       run COMMAND here in the background, through sh (for
#                  example a second SSH login that confirms a guard)
#   !!COMMAND      run COMMAND here, wait for it, then press Enter
#   $NAME          the value of environment variable NAME (a test password,
#                  a public key), then Enter
#   @disconnect    drop the connection at this point and end with success
# A [y/N], [Y/n] or typed-word question that no rule knows ends the run with
# exit code 3 instead of waiting; no matching output for 50 minutes (or
# ANSWER_TIMEOUT seconds) ends it with 4. Otherwise the exit code is the
# command's own.
encoding system utf-8
if {[llength $argv] < 3} {
  puts stderr "usage: answer.exp RULES LOG COMMAND \[ARG ...\]"
  exit 2
}
set rules_file [lindex $argv 0]
set log_path [lindex $argv 1]
set command [lrange $argv 2 end]
set timeout 3000
if {[info exists env(ANSWER_TIMEOUT)]} { set timeout $env(ANSWER_TIMEOUT) }
# Only the end of the output matters, but a rule may span several lines.
match_max 1000000
set stty_init "rows 40 cols 120"

set rules {}
set f [open $rules_file r]
fconfigure $f -encoding utf-8
while {[gets $f line] >= 0} {
  if {$line eq "" || [string index $line 0] eq "#"} continue
  set at [string first " ==> " $line]
  if {$at < 0} {
    set pattern [string trimright $line " =>"]
    set answer ""
  } else {
    set pattern [string range $line 0 [expr {$at - 1}]]
    set answer [string range $line [expr {$at + 5}] end]
  }
  lappend rules [list $pattern $answer]
}
close $f

proc respond {answer} {
  if {[string range $answer 0 1] eq "!!"} {
    catch {exec sh -c "[string range $answer 2 end] </dev/null >/dev/null 2>&1"}
    send -- "\r"
  } elseif {[string index $answer 0] eq "!"} {
    exec sh -c "[string range $answer 1 end] </dev/null >/dev/null 2>&1 &"
  } elseif {[string index $answer 0] eq "\$"} {
    send -- "$::env([string range $answer 1 end])\r"
  } elseif {$answer eq "@disconnect"} {
    close
    catch wait
    exit 0
  } else {
    send -- "$answer\r"
  }
}

log_file -noappend $log_path
spawn -noecho {*}$command
catch {fconfigure $spawn_id -encoding utf-8}

set clauses {}
foreach rule $rules {
  lassign $rule pattern answer
  lappend clauses -re "${pattern}\[^\n\]*$" [list respond $answer]
}
lappend clauses -re {(\[y/N\]|\[Y/n\]|请输入 \[[A-Z]+\]): $} {
  puts stderr "\nanswer.exp: a question no rule answers: [string range $expect_out(buffer) end-300 end]"
  exit 3
}
lappend clauses timeout {
  puts stderr "\nanswer.exp: no expected output for $timeout seconds"
  exit 4
}
lappend clauses eof {
  set result [wait]
  exit [lindex $result 3]
}
while 1 {
  expect {*}$clauses
}
