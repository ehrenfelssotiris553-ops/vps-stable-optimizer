#!/usr/bin/expect -f
# Drives one interactive command of the tool on a pseudo terminal (CI only).
# Usage: answer.exp RULES LOG COMMAND [ARG ...]
#
# RULES holds lines "pattern ==> answer". The pattern is a regular expression
# for the question waiting at the end of the output; the first rule whose
# pattern matches answers it. Answers:
#   (nothing)      just Enter
#   !COMMAND       run COMMAND here in the background, through sh (for
#                  example a second SSH login that confirms a guard)
#   !!COMMAND      run COMMAND here, wait for it, then press Enter
#   $NAME          the value of environment variable NAME (a test password,
#                  a public key), then Enter
#   @seq A B ...   A the first time this rule answers, B the second time and
#                  so on; the last one from then on (a menu asked repeatedly)
#   @disconnect    drop the connection at this point and end with success
# A [y/N], [Y/n] or typed-word question that no rule knows ends the run with
# exit code 3 instead of waiting. So does any other question no rule knows (a
# number menu, a free answer): output that ends with ": " and stays so for two
# looks ANSWER_IDLE seconds apart (120 by default). No matching output for 50
# minutes (or ANSWER_TIMEOUT seconds) ends it with 4. One rule answering more
# than ANSWER_REPEAT times (200 by default) ends it with 5: the same question
# asked again and again, as when the tool refuses the answer (that kept output
# coming, so only the job's time limit ended it). Otherwise the exit code is
# the command's own.
encoding system utf-8
if {[llength $argv] < 3} {
  puts stderr "usage: answer.exp RULES LOG COMMAND \[ARG ...\]"
  exit 2
}
set rules_file [lindex $argv 0]
set log_path [lindex $argv 1]
set command [lrange $argv 2 end]
set limit 3000
if {[info exists env(ANSWER_TIMEOUT)]} { set limit $env(ANSWER_TIMEOUT) }
set idle 120
if {[info exists env(ANSWER_IDLE)]} { set idle $env(ANSWER_IDLE) }
set repeat 200
if {[info exists env(ANSWER_REPEAT)]} { set repeat $env(ANSWER_REPEAT) }
set timeout [expr {min($idle, $limit)}]
# Seconds without a matching question so far, and the question-like end of
# the output at the last look (a second look finding it unchanged fails).
set waited 0
set last_tail {}
# Only the end of the output matters, but a rule may span several lines.
match_max 1000000
# Wide enough that no question wraps: tmux draws a wrapped line as two.
set stty_init "rows 40 cols 400"

set rules {}
set f [open $rules_file r]
fconfigure $f -encoding utf-8
while {[gets $f line] >= 0} {
  if {$line eq "" || [string index $line 0] eq "#"} continue
  set at [string first " ==> " $line]
  if {$at < 0} {
    set pattern [string trimright $line " =>"]
    set answer ""
  } else {
    set pattern [string range $line 0 [expr {$at - 1}]]
    set answer [string range $line [expr {$at + 5}] end]
  }
  lappend rules [list $pattern $answer]
}
close $f

proc respond {index} {
  global rules seqpos answered repeat answers waited last_tail expect_out
  set waited 0
  set last_tail {}
  set answer [lindex $rules $index 1]
  puts $answers "[clock format [clock seconds] -format %H:%M:%S] [lindex $rules $index 0] ==> $answer"
  incr answered($index)
  if {$answered($index) > $repeat} {
    puts stderr "\nanswer.exp: \"[lindex $rules $index 0]\" answered $repeat times, asked again: [string range $expect_out(buffer) end-300 end]"
    exit 5
  }
  if {[string range $answer 0 4] eq "@seq "} {
    set items [regexp -all -inline {\S+} [string range $answer 5 end]]
    set answer [lindex $items [expr {min($seqpos($index), [llength $items] - 1)}]]
    incr seqpos($index)
  }
  if {[string range $answer 0 1] eq "!!"} {
    catch {exec sh -c "[string range $answer 2 end] </dev/null >/dev/null 2>&1"}
    send -- "\r"
  } elseif {[string index $answer 0] eq "!"} {
    exec sh -c "[string range $answer 1 end] </dev/null >/dev/null 2>&1 &"
  } elseif {[string index $answer 0] eq "\$"} {
    send -- "$::env([string range $answer 1 end])\r"
  } elseif {$answer eq "@disconnect"} {
    close
    catch wait
    exit 0
  } else {
    send -- "$answer\r"
  }
}

log_file -noappend $log_path
# Every answer sent, with the time and the rule, next to the transcript.
set answers [open "$log_path.answers" w]
fconfigure $answers -encoding utf-8 -buffering line
spawn -noecho {*}$command
catch {fconfigure $spawn_id -encoding utf-8}

# A waiting question is on the last line of the output. Only blank space and
# terminal control sequences may follow it, plus tmux's status line: a session
# re-attached in tmux redraws the whole screen and draws its status line last.
set ctl {(?:[\r \t]|\x1b\[[0-9;?]*[A-Za-z]|\x1b[()][A-Za-z0-9]|\x1b[78=>])}
set noise {(?:(?:\n|}
append noise $ctl {)*\[vps-setup[^\n]*)*} $ctl {*$}
set clauses {}
set index 0
foreach rule $rules {
  set pattern [lindex $rule 0]
  set seqpos($index) 0
  set answered($index) 0
  lappend clauses -re "${pattern}\[^\n\]*${noise}" [list respond $index]
  incr index
}
set unknown {(\[y/N\]|\[Y/n\]|请输入 \[[A-Z]+\]): }
lappend clauses -re "${unknown}${noise}" {
  puts stderr "\nanswer.exp: a question no rule answers: [string range $expect_out(buffer) end-300 end]"
  exit 3
}
set generic {: }
lappend clauses timeout {
  # A question no rule knows, waiting at ": " (a number menu, a free answer).
  set tail {}
  expect -timeout 0 -notransfer -re "${generic}${noise}" {
    set tail [string range $expect_out(buffer) end-300 end]
  }
  if {$tail ne {} && $tail eq $last_tail} {
    puts stderr "\nanswer.exp: a question no rule answers (nothing more for $idle seconds): $tail"
    exit 3
  }
  set last_tail $tail
  incr waited $timeout
  if {$waited >= $limit} {
    puts stderr "\nanswer.exp: no expected output for $limit seconds"
    exit 4
  }
}
lappend clauses eof {
  set result [wait]
  exit [lindex $result 3]
}
while 1 {
  expect {*}$clauses
}
